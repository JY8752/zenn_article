Output vhs/lazy-kana-aiueo.gif

Require lazy-kana

Set Shell "bash"
Set FontSize 32
Set Width 1600
Set Height 1100
Set Framerate 10

Set Theme "nord"

Set Margin 40
Set MarginFill "#6B50FF"
Set BorderRadius 10

Set WindowBar Colorful

Hide
Type "NO_COLOR=0 lazy-kana"
Enter
Show

Sleep 2s

Type "1"
Sleep 1s
Space
Sleep 800ms
Space
Sleep 800ms
Space
Sleep 800ms
Space
Sleep 5s

Escape
Sleep 1s
Type "q"
