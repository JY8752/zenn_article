Output vhs/lazy-kana-04-mistake.gif

Require lazy-kana

Set Shell "bash"
Set FontSize 32
Set Width 1800
Set Height 1400
Set Framerate 10

Set Theme "nord"

Set Margin 40
Set MarginFill "#6B50FF"
Set BorderRadius 10

Set WindowBar Colorful

Type "NO_COLOR=0 lazy-kana" Sleep 500ms Enter
Sleep 2s

Type "4"
Sleep 2s
Space
Sleep 4s

Escape
Sleep 1s
Type "q"
