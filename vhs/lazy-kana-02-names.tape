Output vhs/lazy-kana-02-names.gif

Require lazy-kana

Set Shell "bash"
Set FontSize 32
Set Width 1800
Set Height 1400
Set Framerate 10

Set Theme "nord"

Set Margin 40
Set MarginFill "#6B50FF"
Set BorderRadius 10

Set WindowBar Colorful

Type "NO_COLOR=0 lazy-kana" Sleep 500ms Enter
Sleep 2s

Type "2"
Sleep 1s

Type "れんくん"
Sleep 1s
Enter
Sleep 1s

Type "さきちゃん"
Sleep 1s
Enter
Sleep 1s

Type "はるくん"
Sleep 1s
Enter
Sleep 1s

Type "みおちゃん"
Sleep 1s
Enter
Sleep 1s

Type "ゆうくん"
Sleep 1s
Enter
Sleep 5s

Escape
Sleep 1s
Type "q"
